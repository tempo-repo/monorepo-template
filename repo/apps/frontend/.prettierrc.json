{
  "parser": "typescript",
  "tabWidth": 2,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "semi": true,
  "useTabs": false,
  "arrowParens": "avoid",
  "singleAttributePerLine": true,
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "^~/(.*)$",
    "^@ui/kit$",
    "^@/(.*)$",
    "^@app/(.*)$",
    "^@root/(.*)$",
    "^@test/(.*)$",
    "^@public/(.*)$",
    "^@scripts/(.*)$",
    "^../(.*)$",
    "^./(.*)$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}