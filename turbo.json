{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "start:production": {
      "dependsOn": ["^start:production"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}